-- An example facilitating how Ibis would look for embedded development
-- (hypothetically)

import Control.Monad.Spinlock (spinForever)
import Control.Monad.IO

site HSite where
  cover @MMIO : 0xa000 .. 0xafff volatile
  cover @J has {@MMIO}

def PIN_0 : Nat = 0x02
def PIN_HIGH : Nat = 0xffff

def poll_mmio_pin {H : HSite} (pin : Nat) : IO Nat := do
  %covers_j @J
  r' <- %res [@MMIO + @PIN_0]
  pure r'

def write_mmio_pin {H : HSite} (pin : Nat) (v : Nat) : IO Nat := do
  %covers_j @J
  r' <- %res [@MMIO + @PIN_0]
  r'' <- %write r' v
  pure r''

def main {H : HSite} : IO () := spinForever $ do
  -- read the pointer
  state <- poll_mmio_pin PIN_0
  -- write a value
  wstate <- write_mmio_pin PIN_0 PIN_HIGH
  rstate <- poll_mmio_pin PIN_0
