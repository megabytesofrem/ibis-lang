site MemorySite where
  covers: [~a]
  morphisms:
    a_identity: ~a -> ~a

struct MemoryStruct {σ : @MemorySite} {α : ∀α.α} where
  ptr_in_a: Ptr α {~a ~> σ}

def main {σ : @MemorySite} {α : ∀α.α} (s : MemoryStruct {σ} α) : IO () :=
  let! allocd : Ptr α {~a ~> σ} = alloc 50 ~a in
  let! bytes : ByteArray = mkByteArray "Hello world\0" in
  let! copied_bytes : Ptr α {~a ~> σ} = mcopy allocd bytes in
  let! struct_ref : Ptr α {~a ~> σ} = update! s { ptr_in_a : copied_bytes } in
  println (&struct_ref.ptr_in_a)